{
  "name": "delegated-security-manager",
  "version": "1.0.0",
  "description": "Covenant Delegated Security Manager",
  "homepage": "https://github.com/covenant-gov/delegated-security-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/covenant-gov/delegated-security-manager.git"
  },
  "license": "MIT",
  "author": "Covenant",
  "scripts": {
    "build": "forge build",
    "build:optimized": "FOUNDRY_PROFILE=optimized forge build",
    "coverage": "forge coverage --report summary --report lcov --match-path 'test/unit/*'",
    "lint:check": "yarn lint:sol && forge fmt --check",
    "lint:fix": "sort-package-json && forge fmt && yarn lint:sol --fix",
    "lint:sol": "solhint 'src/**/*.sol' 'script/**/*.sol' 'test/**/*.sol'",
    "prepare": "husky",
    "test": "forge test -vvv",
    "test:unit": "forge test --match-path 'test/unit/*' -vvv"
  },
  "lint-staged": {
    "*.{js,css,md,ts,sol}": "forge fmt",
    "(src|test|script)/**/*.sol": "yarn lint:sol",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "hats-core": "github:Hats-Protocol/hats-protocol",
    "hats-zodiac": "github:Hats-Protocol/hats-zodiac"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "forge-std": "github:foundry-rs/forge-std#1.9.2",
    "halmos-cheatcodes": "github:a16z/halmos-cheatcodes#c0d8655",
    "husky": ">=9",
    "lint-staged": ">=10",
    "solhint-community": "4.0.1",
    "sort-package-json": "2.10.0"
  }
}
